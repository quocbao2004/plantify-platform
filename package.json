{
  "name": "plantify-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plantify - Nền tảng thương mại & cho thuê cây cảnh",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && .\\.venv\\Scripts\\python.exe manage.py runserver 8001",
    "dev:frontend": "cd frontend && npm run dev",
    "check:backend": "cd backend && .\\.venv\\Scripts\\python.exe manage.py check",
    "lint:frontend": "cd frontend && npm run lint",
    "test:frontend": "cd frontend && npm test -- --run",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
