# ==========================================
# Plantify Backend Environment Configuration
# ==========================================

# Django Security & Core Settings
SECRET_KEY=plantify-super-secret-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Default SQLite for local development:
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# PostgreSQL / Supabase Configuration (uncomment when using PostgreSQL):
# DATABASE_ENGINE=django.db.backends.postgresql
# POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD='YOUR_DATABASE_PASSWORD'
# POSTGRES_SSLMODE=require
# POSTGRES_CONNECT_TIMEOUT=10
# POSTGRES_CONN_MAX_AGE=60

# CORS Configuration (comma-separated origins allowed to access API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# JWT Configuration (JSON Web Token Authentication)
# Tokens are signed with SECRET_KEY using HMAC-SHA256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Password Hashing Architecture:
# Passwords are encrypted using Django's PBKDF2 with SHA-256 (PASSWORD_HASHERS)
# Automatic cryptographic salting and iterative stretching ensure secure password_hash.

# OAuth / Social Authentication (Google & Facebook)
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
