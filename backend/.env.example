# Django Secret Key & Debug Mode
SECRET_KEY=plantify-super-secret-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Default SQLite for Dev, easily switched to Postgres)
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# PostgreSQL / Supabase: set DATABASE_ENGINE=django.db.backends.postgresql
# and uncomment the settings below. Keep real passwords only in .env.
# POSTGRES_HOST=db.YOUR_PROJECT_REF.supabase.co
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD='YOUR_DATABASE_PASSWORD'
# POSTGRES_SSLMODE=require
# POSTGRES_CONNECT_TIMEOUT=10
# POSTGRES_CONN_MAX_AGE=60
# IPv4-only networks: copy the Session pooler host and username from
# Supabase Dashboard > Connect > Session pooler. Do not guess the pooler host.

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
