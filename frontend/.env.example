# ===========================================
# Plantify Frontend Environment Configuration
# ===========================================

# Application Metadata
VITE_APP_NAME=Plantify
VITE_APP_ENV=development

# Backend Django REST Framework API Base URL
# Points to Django backend API v1 (JWT Auth endpoints: /accounts/login/, /accounts/refresh/)
VITE_API_BASE_URL=http://localhost:8001/api/v1

# Request Timeout (milliseconds)
VITE_API_TIMEOUT=15000

# ===========================================
# Authentication & LocalStorage Architecture
# ===========================================
# The frontend uses JWT authentication with the following localStorage keys:
# - plantify_access_token   : JWT Access Token attached via 'Authorization: Bearer <token>'
# - plantify_refresh_token  : JWT Refresh Token used by Axios interceptor to rotate expired tokens
# - plantify_user           : Serialized user profile session object

# ===========================================
# OAuth / Social Authentication
# ===========================================
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=your-facebook-app-id
